# Copy to `.env` and fill in the values.

# --- Database ---------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL="file:./dev.db"
# Postgres (production) — also change `provider` in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@localhost:5432/taskflow?schema=public"

# --- Security ---------------------------------------------------------------
# REQUIRED. 32+ random bytes. Rotating it invalidates all sessions & invites.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# --- App --------------------------------------------------------------------
APP_URL="http://localhost:3000"

# --- AI assistant -----------------------------------------------------------
# "local"  -> built-in deterministic analysis engine, no API key, no egress.
# "openai" -> any OpenAI-compatible endpoint (OpenAI, Azure, Groq, Ollama, ...).
#             The key is only ever read server-side (src/lib/ai/provider.ts).
AI_PROVIDER="local"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# --- Demo seed --------------------------------------------------------------
DEMO_EMAIL="demo@taskflow.ai"
DEMO_PASSWORD="Demo1234!"
